# Godot
.godot/
*.tmp
export_presets.cfg

# Generated test / QA output
artifacts/*
!artifacts/.gdignore

# Tooling caches
.waterfree/
__pycache__/
*.pyc

# Art packs are licensed separately from the source repository.
assets/props/dungeon/

# The two nature packs, on the same footing as the dungeon kit above: the art
# is licensed to the machine, not published with the source. The READMEs stay,
# so where each pack came from and how it was prefixed is on the record.
assets/props/nature/*
!assets/props/nature/README.md
assets/props/wild/*
!assets/props/wild/README.md

# Suite logs and one-off exports from a working session
scratch/logs/
scratch/*.json
# Documentation captures are source material; Godot's generated sidecars are not.
/docs/screenshots/*
!/docs/screenshots/*.png
/.claude/worktrees

# Agent worktrees
.claude/
/visualqa/walk_shots

# Frozen addon releases (tools/release_brick_wild.ps1). They hold the licensed
# prop packs, so they are never committed; consumers install from this folder.
/releases/
/visualqa/personality/brief_evidence
/visualqa/personality/group_evidence
/visualqa/personality/room_evidence
/visualqa/personality/asset_evidence
