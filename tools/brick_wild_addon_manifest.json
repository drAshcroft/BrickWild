{
  "schema_version": 2,
  "package_version": "0.1.0",
  "metadata": [
    {
      "source": "packaging/brick_wild/plugin.cfg",
      "destination": "plugin.cfg"
    },
    {
      "source": "packaging/brick_wild/README.md",
      "destination": "README.md"
    },
    {
      "source": "packaging/brick_wild/VERSION",
      "destination": "VERSION"
    },
    {
      "source": "docs/PUBLIC_API_TRANSPORT.md",
      "destination": "PUBLIC_API_TRANSPORT.md"
    }
  ],
  "_script_trees_note": "Every .gd under a script tree ships with its .uid; new files need no manifest edit. A new src/ directory must be added here or the installer test fails. 'scripts' holds only the files that do not follow their directory's rule.",
  "script_trees": [
    {
      "source": "src/api",
      "destination": "api"
    },
    {
      "source": "src/bridge",
      "destination": "families/bridge"
    },
    {
      "source": "src/castle",
      "destination": "families/castle"
    },
    {
      "source": "src/church",
      "destination": "families/church"
    },
    {
      "source": "src/hotel",
      "destination": "families/hotel"
    },
    {
      "source": "src/house",
      "destination": "families/house"
    },
    {
      "source": "src/shop",
      "destination": "families/shop"
    },
    {
      "source": "src/temple",
      "destination": "families/temple"
    },
    {
      "source": "src/tree",
      "destination": "families/tree"
    },
    {
      "source": "src/village",
      "destination": "families/village"
    },
    {
      "source": "src/windmill",
      "destination": "families/windmill"
    },
    {
      "source": "src/world",
      "destination": "families/world"
    },
    {
      "source": "core",
      "destination": "core"
    },
    {
      "source": "qa",
      "destination": "runtime/qa",
      "exclude": [
        "house_nav_check.gd",
        "walk_grid.gd"
      ]
    }
  ],
  "scripts": [
    {
      "source": "qa/house_nav_check.gd",
      "destination": "runtime/navigation/house_nav_check.gd"
    },
    {
      "source": "qa/walk_grid.gd",
      "destination": "runtime/navigation/walk_grid.gd"
    },
    {
      "source": "src/ui/blueprint_view.gd",
      "destination": "families/ui/blueprint_view.gd"
    },
    {
      "source": "src/ui/house_sheet.gd",
      "destination": "families/ui/house_sheet.gd"
    }
  ],
  "files": [
    {
      "source": "assets/props/catalog.json",
      "destination": "assets/props/catalog.json"
    }
  ],
  "trees": [
    {
      "source": "assets/props/dungeon",
      "destination": "assets/props/dungeon",
      "exclude_suffixes": [
        ".import"
      ]
    },
    {
      "source": "assets/props/nature",
      "destination": "assets/props/nature",
      "exclude_suffixes": [
        ".import"
      ]
    },
    {
      "source": "assets/props/wild",
      "destination": "assets/props/wild",
      "exclude_suffixes": [
        ".import"
      ]
    },
    {
      "source": "assets/props/fantasy",
      "destination": "assets/props/fantasy",
      "exclude_suffixes": [
        ".import"
      ]
    }
  ]
}
